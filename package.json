{
  "name": "ie307",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.10.1",
    "turbo": "^2.11.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev -F api",
    "dev:mobile": "turbo run dev -F mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  }
}
